---
import '../styles/global.css';
const { title = 'UIAPduino Watch', description = '国内外のUIAPduino情報を集める非公式コミュニティ・インデックス' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} /><meta name="theme-color" content="#176a56" />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <title>{title}</title>
</head>
<body>
  <a class="skip" href="#main">本文へスキップ</a>
  <header class="site-header"><div class="wrap header-inner">
    <a class="brand" href={base}><span class="brand-symbol" aria-hidden="true">⌘</span> UIAPduino <strong>Watch</strong></a>
    <nav aria-label="メイン"><a href={`${base}resources/`}>情報を探す</a><a href={`${base}about/`}>このサイトについて</a></nav>
  </div></header>
  <div class="notice"><div class="wrap"><strong>UNOFFICIAL / 非公式</strong> UIAPduino Watchは非公式のコミュニティ情報ポータルです。UIAP公式とは関係ありません。</div></div>
  <main id="main"><slot /></main>
  <footer class="wrap site-footer"><p><strong>UIAPduino Watch</strong><br />作る人、学ぶ人、つなぐ人のためのコミュニティ・インデックス。</p><p>掲載情報は確認時点の内容です。製品仕様・価格・在庫は元サイトでご確認ください。<br /><a href={`${base}about/`}>掲載方針・修正依頼</a> · <a href="https://github.com/tana1980/UIAPduino_Watch">GitHubで参加する ↗</a></p></footer>
</body>
</html>
