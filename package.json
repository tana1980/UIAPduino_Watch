{
  "name": "uiapduino-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "validate": "node scripts/validate-data.mjs",
    "check:links": "node --use-env-proxy scripts/check-links.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/smoke-browser.mjs"
  },
  "dependencies": {
    "astro": "^5.16.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.0"
  }
}
